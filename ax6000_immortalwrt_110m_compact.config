# OpenWrt / ImmortalWrt 25.12 target profile for Redmi AX6000 110M compact build
# 包含组件：PassWall (Xray + SingBox) + AdGuardHome Lite + 官方命令行版 Tailscale

# ========== 目标机型与 110M 大分区固件格式 ==========
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-110m=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ========== 基础界面与实用插件 ==========
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_LUCI_LANG_zh_cn=y
CONFIG_LUCI_LANG_en=y

# ========== PassWall 核心与分流引擎（适配 25.12 纯 nftables 架构） ==========
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y

# 显式关闭所有依赖 Rust 的默认组件（核心修复，防止编译耗时巨大的 rust 工具链！）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssurl is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssmanager is not set
# CONFIG_PACKAGE_rust is not set

# ========== AdGuard Home 助手（仅内置轻量界面，开机后一键在线安装最新内核进闪存） ==========
CONFIG_PACKAGE_luci-app-adguardhome-lite=y
# CONFIG_PACKAGE_adguardhome is not set

# ========== 官方纯命令行版 Tailscale（稳定无界面冲突，配合开机自启子网路由） ==========
CONFIG_PACKAGE_tailscale=y

# ========== 常用基础网络工具 ==========
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y

# ========== 标准内核与固件体积优化 ==========
CONFIG_OPTIMIZE_FOR_SIZE=y
CONFIG_STRIP_KERNEL_EXPORTS=y
