# OpenWrt 24.10 and 25.12 target profile for Redmi AX6000 110M compact build

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-110m=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-msd_lite=y
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
#CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-theme-argon=y


# ========== OpenClash  ==========
#CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_dnsmasq-full=y
#CONFIG_PACKAGE_ip-full=y
#CONFIG_PACKAGE_unzip=y
#CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_luci-compat=y

CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# ========== passwall ==========
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y

# ========== 完美勾选 kenzok8/openwrt-daede 一体包 ==========
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_luci-i18n-daede-zh-cn=y
CONFIG_PACKAGE_ca-bundle=y

# ========== DAE 完整 BPF 内核选项（修复拼写，优化体积） ==========
CONFIG_KERNEL_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_NET_INGRESS=y
CONFIG_KERNEL_NET_EGRESS=y
CONFIG_KERNEL_NET_CLS_ACT=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y

# [体积无损缩减方案] 开启此项能减少内核体积，同时保留 DAE 必须的 BTF 数据，防止编译报 Image too big
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y

# ========== DAE 内核级绑定模块 kmod (固件硬内置) ==========
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-ingress=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y


# ========== 插件选择 ==========
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-arpbind=y



# ========== LuCI语言：保留简体中文 + 英文，其余全部关闭 ==========
CONFIG_LUCI_LANG_zh-cn=y
CONFIG_LUCI_LANG_en=y


# ========== 编译体积优化选项 ==========
CONFIG_OPTIMIZE_FOR_SIZE=y
CONFIG_STRIP_KERNEL_EXPORTS=y
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_PACKAGE_man is not set
# CONFIG_PACKAGE_doc is not set

# ========== 工具包：保留 curl wget，去掉nano、vim-full ==========
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_vim-full is not set
# CONFIG_PACKAGE_python3 is not set
# CONFIG_PACKAGE_perl is not set
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y

# ========== 关闭USB全套驱动（AX6000无USB硬件） ==========
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-ohci is not set
# CONFIG_PACKAGE_kmod-usb-uhci is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-audio is not set

# ========== 关闭蓝牙 ==========
# CONFIG_PACKAGE_kmod-bluetooth is not set

# ========== 关闭不使用的文件系统驱动 ==========
# CONFIG_PACKAGE_kmod-fs-cifs is not set
# CONFIG_PACKAGE_kmod-fs-nfs is not set
# CONFIG_PACKAGE_kmod-fs-fuse is not set
