# OpenWrt 25.12 target profile for Redmi AX6000 110M compact build (PassWall + AdGuardHome Lite)

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-110m=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-theme-argon=y

# 仅生成 sysupgrade.bin 固件，关闭多余模块加快编译
# CONFIG_ALL is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ========== PassWall 核心与分流引擎 ==========
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y

# 关闭依赖 Rust 的多余组件以加速编译
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssurl is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssmanager is not set
# CONFIG_PACKAGE_rust is not set

# ========== AdGuard Home 助手（仅内置轻量界面，开机后一键安装最新内核进闪存） ==========
CONFIG_PACKAGE_luci-app-adguardhome-lite=y
# CONFIG_PACKAGE_adguardhome is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set

# ========== 彻底清理 daed、Tailscale 与 SmartDNS ==========
# CONFIG_PACKAGE_luci-app-daede is not set
# CONFIG_PACKAGE_tailscale is not set
# CONFIG_PACKAGE_luci-app-tailscale is not set
# CONFIG_PACKAGE_smartdns is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set

# ========== 常用基础网络工具 ==========
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y

# ========== LuCI 语言：保留简体中文 + 英文 ==========
CONFIG_LUCI_LANG_zh_cn=y
CONFIG_LUCI_LANG_en=y

# ========== 恢复标准体积优化（大幅减小内核体积） ==========
CONFIG_OPTIMIZE_FOR_SIZE=y
CONFIG_STRIP_KERNEL_EXPORTS=y
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_BTF is not set
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_PACKAGE_man is not set
# CONFIG_PACKAGE_doc is not set

# ========== 关闭无硬件驱动（USB / 蓝牙 / 远程文件系统） ==========
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-ohci is not set
# CONFIG_PACKAGE_kmod-usb-uhci is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-audio is not set
# CONFIG_PACKAGE_kmod-bluetooth is not set
# CONFIG_PACKAGE_kmod-fs-cifs is not set
# CONFIG_PACKAGE_kmod-fs-nfs is not set
# CONFIG_PACKAGE_kmod-fs-fuse is not set
